# Host-side HTTP port. Keep the Compose bind on 127.0.0.1.
HOST_PORT=3020
LOG_LEVEL=info

# Set false only for direct, local HTTP testing. Use true behind HTTPS.
COOKIE_SECURE=true

# Generated by ./init-secrets.sh. Do not commit real values.
JWT_SECRET=
AUTH_JWT_SECRET=
ENCRYPTION_SERVER_KEY=
PSEUDO_KEY_PARAMS_KEY=
VALET_TOKEN_SECRET=

# WebAuthn (hardware keys) must match the origin you actually use.
# For localhost the relying party id is 'localhost'; for your own domain
# use that domain and its https origin (comma-separated if several).
U2F_RELYING_PARTY_ID=localhost
U2F_EXPECTED_ORIGIN=http://localhost:3020
